ARBITRUM_RPC_URL="https://arb1.arbitrum.io/rpc"
# Private key of the signer address set in ReceiverStaking
SIGNER_PRIVATE_KEY="<signer_private_key>"

# Replace it with name if required
NETWORK_ID="0xaaaebeba3810b1e6b70781f14b2d72c1cb89c0b2b320c43bb67ff79f562f5ff4" 

# How to run the job
RUN_JOB_AFTER_MILLISECOND=120000
IF_FAILED_RETRY_AFTER=120000

# Marlin staking subgraph on The Graph network, needs an API key from https://thegraph.com/studio/apikeys/
SUBGRAPH_URL="https://gateway.thegraph.com/api/<api_key>/subgraphs/id/GUh83DEwZWMTkKaydusdkb46mLuAC7FTL4km1bcNjugc"

# Receiver Database Config
RECEIVER_DATABASE_HOST="localhost"
RECEIVER_DATABASE_USER="postgres"
RECEIVER_DATABASE_PASSWORD="postgres"
RECEIVER_DATABASE_NAME="receiver"
RECEIVER_DATABASE_PORT="5432"
RECEIVER_DATABASE_MAX_CONNECTIONS=5

# Ticket Database Config
TICKET_DATABASE_HOST="localhost"
TICKET_DATABASE_USER="postgres"
TICKET_DATABASE_PASSWORD="postgres"
TICKET_DATABASE_NAME="ticket"
TICKET_DATABASE_PORT="5432"
TICKET_DATABASE_MAX_CONNECTIONS=5

# Runtime optional configuration
GAS_PRICE_INCREMENT="110" # this means gas price will increase by 10% if unmined transaction is found, default = 110
MAX_EPOCHS_PER_TRANSACTION_TO_SUBMIT=96 # default = 96
# Gas limit set on every ticket transaction, default = 10000000. The client does not submit
# if the estimated gas is higher than this. A batch of 96 epochs uses about 3.3M gas, so do
# not set this lower than that for the batch size above.
# MAX_GAS_LIMIT="10000000"
MAX_OBJECTS_PER_SUBGRAPH_QUERY=999 # default=999
TRANSACTION_WAIT_TIME=60000 # time in ms to wait for a transaction before checking on it again, default = 1200000
HTTP_TIMEOUT=30000 # time in ms to wait for a response from subgraph or telemetry url, default = 30000
